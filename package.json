{
  "name": "lavka-storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:performance": "lhci autorun --config=./lighthouserc.json",
    "test:all": "bun run lint && bun run typecheck && bun run test:coverage && bun run test:security && bun run build && bun run test:e2e && bun run test:performance",
    "audit": "bun audit --audit-level=high",
    "check": "bun run lint && bun run typecheck && bun run test:coverage",
    "start:ci": "next start --hostname 127.0.0.1",
    "test:security": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
