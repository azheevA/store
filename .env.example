# Local development URL. On Vercel, NEXT_PUBLIC_SITE_URL may be omitted:
# the app will use VERCEL_PROJECT_PRODUCTION_URL as its canonical origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# If you use a custom domain, set NEXT_PUBLIC_SITE_URL to its full HTTPS origin
# in Vercel Project Settings -> Environment Variables (Production).
